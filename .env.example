# Copy this file to ~/.skillswiki/.env
#
# Optional. Your own TypeSafe key turns on JEV routing, suite checks and the grading cascade.
# Get one at https://console.typesafe.ai/ . You are TypeSafe's customer; Skills Wiki never sees it.
TYPESAFE_API_KEY=
# SKILLSWIKI_JEV=off        # set to off to disable JEV even when a key is present
# SKILLSWIKI_HOME=~/.skillswiki
# SKILLSWIKI_SCAN_ROOTS=    # extra skill folders, ':'-separated
